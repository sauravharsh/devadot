name = DevaRemoveReph;
},
{
automatic = 1;
code = "languagesystem DFLT dflt;

languagesystem dev2 dflt;
languagesystem dev2 MAR;

languagesystem latn dflt;
languagesystem latn NLD;

languagesystem deva dflt;
languagesystem deva MAR;
";
name = Languagesystems;
}
);
features = (
{
automatic = 1;
code = "feature locl;
feature nukt;
feature akhn;
feature rphf;
feature rkrf;
feature blwf;
feature half;
feature cjct;
feature blws;
feature pres;
feature abvs;
feature calt;
feature fwid;
feature salt;
";
tag = aalt;
},
{
automatic = 1;
code = "lookup ccmp_DFLT_1 {
	@CombiningTopAccents = [acutecomb circumflexcomb dieresiscomb dotaccentcomb gravecomb ringcomb tildecomb];
	lookupflag UseMarkFilteringSet @CombiningTopAccents;
	sub j' @CombiningTopAccents by jdotless;
} ccmp_DFLT_1;
";
tag = ccmp;
},
{
automatic = 1;
code = "script dev2;
language MAR;
lookup locl_dev2_0 {
	sub la-deva by la-deva.loclMAR;
	sub l-deva by l-deva.loclMAR;
	sub sha-deva by sha-deva.loclMAR;
	sub sh-deva by sh-deva.loclMAR;
} locl_dev2_0;

script latn;
language NLD;
lookup locl_latn_0 {
	sub iacute j' by jacute;
	sub Iacute J' by Jacute;
} locl_latn_0;
";
tag = locl;
},
{
automatic = 1;
code = "lookup NuktDecomp {
	sub qa-deva by ka-deva nukta-deva;
	sub khha-deva by kha-deva nukta-deva;
	sub ghha-deva by ga-deva nukta-deva;
	sub za-deva by ja-deva nukta-deva;
	sub dddha-deva by dda-deva nukta-deva;
	sub rha-deva by ddha-deva nukta-deva;
	sub nnna-deva by na-deva nukta-deva;
	sub fa-deva by pha-deva nukta-deva;
	sub yya-deva by ya-deva nukta-deva;
	sub llla-deva by lla-deva nukta-deva;
} NuktDecomp;
lookup NuktComp {
	sub ra-deva nukta-deva by rra-deva;
} NuktComp;

script dev2;
lookup NuktDecomp;
lookup NuktComp;
language MAR;
lookup NuktDecomp;
lookup NuktComp;

script deva;
lookup NuktDecomp;
lookup NuktComp;
language MAR;
lookup NuktDecomp;
lookup NuktComp;
";
tag = nukt;
},
{
automatic = 1;
code = "lookupflag 0;
script dev2;
lookup Akhn_devanagari {
	sub ka-deva halant-deva ssa-deva halant-deva by k_ss-deva;
	sub ka-deva halant-deva ssa-deva by k_ssa-deva;
	sub ja-deva halant-deva nya-deva halant-deva by j_ny-deva;
	sub ja-deva halant-deva nya-deva by j_nya-deva;
} Akhn_devanagari;
language MAR;
lookup Akhn_devanagari;
script deva;
lookup Akhn_devanagari;
language MAR;
lookup Akhn_devanagari;
";
tag = akhn;
},
{
automatic = 1;
code = "script dev2;
lookup Rphf_deva {
	sub ra-deva halant-deva by reph-deva;
} Rphf_deva;
language MAR;
lookup Rphf_deva;

script deva;
lookup Rphf_deva;
language MAR;
lookup Rphf_deva;
";
tag = rphf;
},
{
automatic = 1;
code = "script dev2;
lookup rakar {
	sub halant-deva ra-deva by rakar-deva;
} rakar;
language MAR;
lookup rakar;

script deva;
lookup rakar;
language MAR;
lookup rakar;
";
tag = rkrf;
},
{
automatic = 1;
code = "script deva;
sub ra-deva halant-deva by rakar-deva;
";
tag = blwf;
},
{
automatic = 1;
code = "@halantdeva = [halant-deva];
lookup dev2_half {
	lookupflag UseMarkFilteringSet @halantdeva;
	sub ka-deva halant-deva by k-deva;
	sub kha-deva halant-deva by kh-deva;
	sub ga-deva halant-deva by g-deva;
	sub gha-deva halant-deva by gh-deva;
	sub ca-deva halant-deva by c-deva;
	sub cha-deva halant-deva by ch-deva;
	sub ja-deva halant-deva by j-deva;
	sub jha-deva halant-deva by jh-deva;
	sub nya-deva halant-deva by ny-deva;
	sub nna-deva halant-deva by nn-deva;
	sub ta-deva halant-deva by t-deva;
	sub tha-deva halant-deva by th-deva;
	sub dha-deva halant-deva by dh-deva;
	sub na-deva halant-deva by n-deva;
	sub nnna-deva halant-deva by nnn-deva;
	sub pa-deva halant-deva by p-deva;
	sub pha-deva halant-deva by ph-deva;
	sub ba-deva halant-deva by b-deva;
	sub bha-deva halant-deva by bh-deva;
	sub ma-deva halant-deva by m-deva;
	sub ya-deva halant-deva by y-deva;
	sub rra-deva halant-deva by rr-deva;
	sub la-deva halant-deva by l-deva;
	sub lla-deva halant-deva by ll-deva;
	sub llla-deva halant-deva by lll-deva;
	sub va-deva halant-deva by v-deva;
	sub sha-deva halant-deva by sh-deva;
	sub ssa-deva halant-deva by ss-deva;
	sub sa-deva halant-deva by s-deva;
	sub ha-deva halant-deva by h-deva;
	sub qa-deva halant-deva by q-deva;
	sub khha-deva halant-deva by khh-deva;
	sub ghha-deva halant-deva by ghh-deva;
	sub za-deva halant-deva by z-deva;
	sub fa-deva halant-deva by f-deva;
	sub yya-deva halant-deva by yy-deva;
	sub la-deva.loclMAR halant-deva by l-deva.loclMAR;
	sub sha-deva.loclMAR halant-deva by sh-deva.loclMAR;
